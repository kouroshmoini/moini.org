---
layout: null
permalink: /assets/search.json
---
[
  {% assign posts = site.posts | where_exp: "post", "post.visibility != 'hidden'" | where_exp: "post", "post.noindex != true" %}
  {% for post in posts %}
    {
      "type": "Post",
      "title": {{ post.title | jsonify }},
      "url": {{ post.url | relative_url | jsonify }},
      {% capture search_text %}
        {{ post.subtitle }} {{ post.seo_description }}
        {% if post.content_blocks and post.content_blocks.size > 0 %}
          {% for block in post.content_blocks %}
            {{ block.block_label }}
            {% if block._block == 'rich_text' %}{{ block.content | markdownify | strip_html }}{% endif %}
          {% endfor %}
        {% else %}
          {{ post.content | strip_html }}
        {% endif %}
      {% endcapture %}
      "text": {{ search_text | normalize_whitespace | jsonify }}
    },
  {% endfor %}
  {% assign searchable_urls = '/|/about/|/blog/|/projects/chinatown-gateway/' | split: '|' %}
  {% for url in searchable_urls %}
    {% assign entry = site.pages | where: "url", url | first %}
    {% if entry and entry.noindex != true %}
      {
        "type": {% if url contains '/projects/' %}"Project"{% else %}"Page"{% endif %},
        "title": {{ entry.title | jsonify }},
        "url": {{ entry.url | relative_url | jsonify }},
        "text": {{ entry.content | strip_html | normalize_whitespace | jsonify }}
      },
    {% endif %}
  {% endfor %}
  {
    "type": "Section",
    "title": "Selected work",
    "url": {{ '/#selected-work' | relative_url | jsonify }},
    "text": "Urban planning GIS projects portfolio"
  }
]
